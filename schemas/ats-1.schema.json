{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-team-foundation/ai-tell-scan/schemas/ats-1.schema.json",
  "title": "AI Tell Scan result",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "target",
    "scan",
    "summary",
    "candidateSetDigest",
    "review",
    "candidates",
    "tells",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ats-1"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ai-tell-scan" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["label", "targetId", "frameworks", "sourceDigest"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "frameworks": {
          "type": "array",
          "items": { "enum": ["react", "nextjs"] },
          "uniqueItems": true
        },
        "sourceDigest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      },
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scan": {
      "type": "object",
      "required": ["status", "reason", "filesExamined", "uiFilesExamined", "rulesEvaluated", "readOnly"],
      "properties": {
        "status": { "enum": ["unsupported", "not-applicable", "needs-review", "completed"] },
        "reason": { "type": "string", "minLength": 1 },
        "filesExamined": { "type": "integer", "minimum": 0 },
        "uiFilesExamined": { "type": "integer", "minimum": 0 },
        "rulesEvaluated": { "type": "integer", "minimum": 0 },
        "readOnly": { "const": true }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["candidateCount", "confirmedCount", "rejectedCount", "reportedCount", "suppressedConfirmedCount"],
      "properties": {
        "candidateCount": { "type": "integer", "minimum": 0 },
        "confirmedCount": { "type": "integer", "minimum": 0 },
        "rejectedCount": { "type": "integer", "minimum": 0 },
        "reportedCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "suppressedConfirmedCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "candidateSetDigest": { "$ref": "#/$defs/sha256" },
    "review": {
      "type": "object",
      "required": ["state", "policy"],
      "properties": {
        "state": { "enum": ["pending", "not-required", "complete"] },
        "policy": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "tells": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/tell" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rescan": {
      "type": "object",
      "required": ["baselineSourceDigest", "resolved", "persisted", "introduced"],
      "properties": {
        "baselineSourceDigest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "resolved": { "type": "array", "items": { "$ref": "#/$defs/tell" } },
        "persisted": { "type": "array", "items": { "$ref": "#/$defs/tell" } },
        "introduced": { "type": "array", "items": { "$ref": "#/$defs/tell" } }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "file", "line", "detail", "excerpt"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "candidateCore": {
      "type": "object",
      "required": [
        "candidateId",
        "ruleId",
        "title",
        "severity",
        "confidence",
        "file",
        "line",
        "whyItHurtsTrust",
        "minimalFix",
        "evidence"
      ],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^ats-[0-9a-f]{16}$" },
        "ruleId": { "type": "string", "pattern": "^ats\\.[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["medium", "high"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "whyItHurtsTrust": { "type": "string", "minLength": 1 },
        "minimalFix": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "disposition": { "enum": ["pending", "confirmed", "rejected"] },
        "reviewRationale": { "type": "string", "minLength": 12 }
      },
      "additionalProperties": true
    },
    "candidate": {
      "allOf": [
        { "$ref": "#/$defs/candidateCore" },
        {
          "type": "object",
          "required": ["disposition"]
        }
      ]
    },
    "tell": {
      "allOf": [
        { "$ref": "#/$defs/candidateCore" },
        {
          "type": "object",
          "required": ["reviewRationale"]
        }
      ]
    }
  },
  "additionalProperties": true
}
